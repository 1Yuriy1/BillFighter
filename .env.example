# Local Postgres for the RLS/audit test suite (Supabase-compatible).
# In production this is the Supabase connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/billfighter_test

# Postmark inbound webhook (/api/inbound). Requests must carry
# X-Webhook-Signature: base64(HMAC-SHA256(rawBody, this secret)) —
# anything else is rejected 401 before the payload is even parsed.
POSTMARK_WEBHOOK_SECRET=

# Domain the per-user aliases and per-case reply addresses live on.
INBOUND_DOMAIN=in.billfighter.com

# Where intake writes attachment files until Supabase storage is wired
# (defaults to the OS temp dir in local dev).
INTAKE_STORAGE_DIR=

# Anthropic API — document extraction (lib/extract.ts). Required outside tests.
ANTHROPIC_API_KEY=

# Optional override for the extraction model (default: claude-haiku-4-5).
ANTHROPIC_MODEL=
